# ─────────────────────────────────────────────────── Copyright Notice ─

SCRIPT_NAME="${BASH_SOURCE[0]/*\/}" # Basename, efficient form.
SCRIPT_PATH_ABS="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" # Fetch real directory, not symlink.  Spaces are well handled.

SCRIPT_NAME_BASE="${SCRIPT_NAME}"
SCRIPT_NAMEANDPATH_ABS="${SCRIPT_PATH_ABS}/${SCRIPT_NAME}"
SCRIPT_PATH_ABS_PARENT="$(dirname "${SCRIPT_PATH_ABS}")"

TIMESTAMP_FORMAT_HUMAN="%Y-%m-%d %H:%M:%S"

unset ANSI
if [ -t 1 ] ; then
  # STDOUT is a terminal.  Set ANSI.  If STDOUT is redirected, ANSI
  # remain unset and no ANSI codes are sent out.

  declare -Ag ANSI=(
    ["FG_WHITE_BG_GREEN"]="\e[1;37;42m"
    ["FG_BLACK_BG_YELLOW"]="\e[1;30;43m"
    ["FG_WHITE_BG_RED"]="\e[1;37;41m"
    ["FG_WHITE_BG_BLUE"]="\e[1;37;44m"
    ["RESET"]="\e[0;00m"
    ["BOLD"]="\e[1m"
    ["GREEN"]="\e[32m"
    ["YELLOW"]="\e[33m"
    ["BLUE"]="\e[34m"
  )
fi


usage()
{
  echo -e "
${ANSI[FG_WHITE_BG_GREEN]} SAFE ${ANSI[RESET]}

  Schedule recurring wakeups at minute XX:<initial minute> every hour.

  -d               Dry-run.
  -e               Execute command. Default is dry-run.
  -i <minute>      Minute in each hour to wake up (0..59). Default: 45
  -w <minutes>     Minutes to stay awake before scheduling next wakeup. Default: 15
  -s <minutes>     Alias of -w.
  -n [HH:MM-HH:MM] No wakeup window. Default: 21:00-06:45.
                   Pass -n without value to disable no-wakeup jumps.
  -h               Display this help text.
"
}


run()
{
  if (( DRYRUN )); then
    echo "DRYRUN:  $@"
    return 0
  fi

  "$@"
}


# ARGUMENT PARSING
# ════════════════════════════════════════════════════════════════════

INITIAL_MINUTE=45
WAKEUP_DELAY_MINUTES=15
DRYRUN=1
NOWAKEUP_WINDOW_DEFAULT="21:00-06:45"
NOWAKEUP_WINDOW="${NOWAKEUP_WINDOW_DEFAULT}"
NOWAKEUP_WINDOW_ENABLED=1
WARNINGS=""
ERRORS=""

OPTIND=1 # Normally not required, except if the script is sourced.
         # Better be safe than sorry.
while getopts ":dei:w:s:n:zh" OPTCMD; do
  case "${OPTCMD}" in
    "d")    DRYRUN=1;;
    "e")    DRYRUN=0;;
    "i")    INITIAL_MINUTE="${OPTARG}";;
    "w")    WAKEUP_DELAY_MINUTES="${OPTARG}";;
    "s")    WAKEUP_DELAY_MINUTES="${OPTARG}";;
    "n")    NOWAKEUP_WINDOW="${OPTARG}"; NOWAKEUP_WINDOW_ENABLED=1;;
    ":")
      if [ "${OPTARG}" == "n" ]; then
        NOWAKEUP_WINDOW_ENABLED=0
      else
        ERRORS="${ERRORS} - Option -${OPTARG} requires a value.\n"
      fi
      ;;
    "h"|*)  usage; exit 1;;
  esac
done

shift $((${OPTIND} - 1))  # Remove options from $@


# VALIDATION
# ════════════════════════════════════════════════════════════════════


# Validate initial minute is an integer between 0 and 59.
if ! [[ "${INITIAL_MINUTE}" =~ ^[0-9]+$ ]]; then
  ERRORS="${ERRORS} - Initial minute must be an integer between 0 and 59.\n"
elif (( 10#${INITIAL_MINUTE} < 0 || 10#${INITIAL_MINUTE} > 59 )); then
  ERRORS="${ERRORS} - Initial minute must be between 0 and 59.\n"
fi

# Validate wakeup delay is a non-negative integer.
if ! [[ "${WAKEUP_DELAY_MINUTES}" =~ ^[0-9]+$ ]]; then
  ERRORS="${ERRORS} - Wakeup delay must be a non-negative integer.\n"
fi

if (( NOWAKEUP_WINDOW_ENABLED )); then
  if [[ ! "${NOWAKEUP_WINDOW}" =~ ^([0-1][0-9]|2[0-3]):[0-5][0-9]-([0-1][0-9]|2[0-3]):[0-5][0-9]$ ]]; then
    ERRORS="${ERRORS} - No-wakeup window must be in HH:MM-HH:MM format (24h).\n"
  else
    NOWAKEUP_START_TIME="${NOWAKEUP_WINDOW%-*}"
    NOWAKEUP_END_TIME="${NOWAKEUP_WINDOW#*-}"

    NOWAKEUP_START_HOUR=${NOWAKEUP_START_TIME%:*}
    NOWAKEUP_START_MINUTE=${NOWAKEUP_START_TIME#*:}
    NOWAKEUP_END_HOUR=${NOWAKEUP_END_TIME%:*}
    NOWAKEUP_END_MINUTE=${NOWAKEUP_END_TIME#*:}

    NOWAKEUP_START_TOTAL_MINUTES=$(( 10#${NOWAKEUP_START_HOUR} * 60 + 10#${NOWAKEUP_START_MINUTE} ))
    NOWAKEUP_END_TOTAL_MINUTES=$(( 10#${NOWAKEUP_END_HOUR} * 60 + 10#${NOWAKEUP_END_MINUTE} ))

    if (( NOWAKEUP_START_TOTAL_MINUTES == NOWAKEUP_END_TOTAL_MINUTES )); then
      ERRORS="${ERRORS} - No-wakeup start and end time cannot be identical.\n"
    fi
  fi
fi

INITIAL_MINUTE=$(( 10#${INITIAL_MINUTE} ))
WAKEUP_DELAY_MINUTES=$(( 10#${WAKEUP_DELAY_MINUTES} ))

HDWAKEUP_COMMAND="${SCRIPT_PATH_ABS}/hdwakeup"

if [ ! -x "${HDWAKEUP_COMMAND}" ]; then
  ERRORS="${ERRORS} - hdwakeup command not found or not executable at: ${HDWAKEUP_COMMAND}\n"
fi

printWarnings()
{
  if [ ! -z "${WARNINGS}" ]; then
    echo -e "${ANSI[FG_BLACK_BG_YELLOW]}WARNING:${ANSI[RESET]}  The following warnings were thrown.\n"
    echo -e "${WARNINGS}"
  fi
}

printErrorsAndExitIfAny()
{
  printWarnings
  if [ ! -z "${ERRORS}" ]; then
    echo -e "${ANSI[FG_WHITE_BG_RED]}ERROR:${ANSI[RESET]}  The following errors were detected.\n"
    echo -e "${ERRORS}"
    echo -e "Command aborted."
    exit 1
  fi
}

printErrorsAndExitIfAny

# ════════════════════════════════════════════════════════════════════
# FUNCTIONS
# ════════════════════════════════════════════════════════════════════

calculateNextWakeTime()
{
  if (( NOWAKEUP_WINDOW_ENABLED )); then
    local now_total_minutes=$((10#$(date +%H) * 60 + 10#$(date +%M)))
    local in_nowakeup_window=0

    if (( NOWAKEUP_START_TOTAL_MINUTES < NOWAKEUP_END_TOTAL_MINUTES )); then
      if (( now_total_minutes >= NOWAKEUP_START_TOTAL_MINUTES && now_total_minutes < NOWAKEUP_END_TOTAL_MINUTES )); then
        in_nowakeup_window=1
      fi
    else
      if (( now_total_minutes >= NOWAKEUP_START_TOTAL_MINUTES || now_total_minutes < NOWAKEUP_END_TOTAL_MINUTES )); then
        in_nowakeup_window=1
      fi
    fi

    if (( in_nowakeup_window )); then
      printf "%s" "${NOWAKEUP_END_TIME}"
      return 0
    fi
  fi

  local now_hour=$((10#$(date +%H)))
  local now_minute=$((10#$(date +%M)))
  local target_hour=${now_hour}

  # If current minute is at/after target minute, schedule next hour.
  if (( now_minute >= INITIAL_MINUTE )); then
    target_hour=$(( target_hour + 1 ))
  fi

  if (( target_hour >= 24 )); then
    target_hour=0
  fi

  printf "%02d:%02d" "${target_hour}" "${INITIAL_MINUTE}"
}

# ════════════════════════════════════════════════════════════════════
# MAIN LOGIC
# ════════════════════════════════════════════════════════════════════

{
echo -n "${SCRIPT_NAME} started in "
if (( DRYRUN )); then
  echo -e "mode: dry-run"
else
  echo -e "mode: execute"
fi

if (( DRYRUN )); then
  EXTRA_ARG="-s"
else
  EXTRA_ARG=""
fi

  cat <<EOM
Wakeup minute each hour: ${INITIAL_MINUTE}
Stay-awake delay after resume: ${WAKEUP_DELAY_MINUTES} minutes
No-wakeup window: $( (( NOWAKEUP_WINDOW_ENABLED )) && echo "${NOWAKEUP_WINDOW}" || echo "disabled" )
hdwakeup command: ${HDWAKEUP_COMMAND}
EOM

  while true; do
    TARGET_TIME=$(calculateNextWakeTime)

    echo -e "Current time: $(date '+%H:%M:%S')"
    echo -e "Next wakeup target: ${TARGET_TIME}"

    echo -e "Executing: ${HDWAKEUP_COMMAND} ${EXTRA_ARG} ${TARGET_TIME}"
    if "${HDWAKEUP_COMMAND}" "${EXTRA_ARG}" "${TARGET_TIME}"; then
      echo -e "hdwakeup completed successfully"
    else
      echo -e "ERROR: hdwakeup failed with exit code $?"
    fi

    if (( WAKEUP_DELAY_MINUTES > 0 )); then
      echo -e "Staying awake for ${WAKEUP_DELAY_MINUTES} minute(s)."
      hdsleep "${WAKEUP_DELAY_MINUTES}m"
    fi
  done
} 2>&1 | \
while IFS= read -r LINE; do
  printf -v NOW '%(%F %T)T'  # ISO 8601 Format, to the seconds.
  echo "${NOW} ${LINE}"
done
