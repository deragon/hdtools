#
#     https://www.gnu.org/licenses/agpl-3.0.en.html
#
# ─────────────────────────────────────────────────── Copyright Notice ─

MARKER="Additional personal instructions"

SCRIPT_NAME="${BASH_SOURCE[0]/*\//}"                              # Basename, efficient form.
SCRIPT_PATH_ABS="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" # Fetch real directory, not symlink.  Spaces are well handled.

unset ANSI
if [ -t 1 ]; then
  # STDOUT is a terminal.  Set ANSI.  If STDOUT is redirected, ANSI
  # remain unset and no ANSI codes are sent out.

  declare -Ag ANSI=(
    ["FG_WHITE_BG_GREEN"]="\e[1;37;42m"
    ["FG_WHITE_BG_RED"]="\e[1;37;41m"
    ["RESET"]="\e[0;00m"
    ["BOLD"]="\e[1m"
  )
fi

usage() {
  echo -e "
${ANSI[FG_WHITE_BG_GREEN]} SAFE ${ANSI[RESET]}

Usage:  ${SCRIPT_NAME} [-r|-a] [-f <file>] [-h]

  -a  Add lines to the file.
  -r  Remove lines from the file.
  -f  File path to process.  Default: '.github/copilot-instructions.md' of current project.
  -h  Display this help text.
"
}

# Define the default file path
HDPROJECTDIR="$(hdprojectdir)"
if [ -z "$HDPROJECTDIR" ]; then
  ERRORS="${ERRORS}\n- Could not determine project directory (hdprojectdir returned nothing)."
else
  FILE_PATH="${HDPROJECTDIR}/.github/copilot-instructions.md"
fi

# Function to remove lines below "IMPORTANT"
remove_lines() {

  # Abort if the marker is missing to avoid truncating the file unexpectedly.
  if ! grep -Fq "${MARKER}" "$FILE_PATH"; then
    echo "Marker '${MARKER}' not found. Nothing removed."
    return 0
  fi

  # Supprime la ligne contenant le marqueur et toutes les lignes suivantes,
  # puis supprime les lignes vides finales pour éviter une fin de fichier vide.
  awk -v m="$MARKER" '{
    lines[++n]=$0
  }
  END {
    idx=0
    for (i=1;i<=n;i++) {
      if (index(lines[i], m)) { idx=i-1; break }
    }
    while (idx>0 && lines[idx] ~ /^[[:space:]]*$/) idx--
    for (i=1;i<=idx;i++) print lines[i]
  }' "$FILE_PATH" >"${FILE_PATH}.tmp" && mv "${FILE_PATH}.tmp" "$FILE_PATH"
  echo "Lines have been removed."
}

# Function to add lines below "IMPORTANT"
add_lines() {
  # Prevent duplicate addition by checking if AI_TEXT is already present
  if grep -Fq "${MARKER}" "$FILE_PATH"; then
    echo "Lines already added. Skipping."
  else
    printf '%s' "${AI_TEXT}" >>"$FILE_PATH"
    echo "Lines have been added."
  fi
}



# ARGUMENT PARSING
# ════════════════════════════════════════════════════════════════════

ACTION=""
COMPLIMENT=0

OPTIND=1 # Normally not required, except if the script is sourced.
# Better be safe than sorry.
while getopts "f:arch" OPTCMD; do
  case "${OPTCMD}" in
  "f") FILE_PATH="${OPTARG}" ;;
  "a") ACTION="add" ;;
  "r") ACTION="remove" ;;
  "c") COMPLIMENT=1;;
  "h" | *)
    usage
    exit 1
    ;;
  esac
done

shift $((${OPTIND} - 1)) # Remove options from $@



# VALIDATION
# ════════════════════════════════════════════════════════════════════

ERRORS=""

if [ -z "${ACTION}" ]; then
  ERRORS="${ERRORS} - You must provide either -r (remove) or -a (add).\n"
fi

if [[ "${ACTION}" = "remove" && ! -f "$FILE_PATH" ]]; then
  ERRORS="${ERRORS} - File not found:  $FILE_PATH\n"
fi

if [ ! -z "${ERRORS}" ]; then
  echo -e "${ANSI[FG_WHITE_BG_RED]}ERROR:${ANSI[RESET]}  The following errors were detected.\n"
  echo -e "${ERRORS}"
  echo -e "Command aborted."
  usage
  exit 1
fi



# PROCESSING
# ════════════════════════════════════════════════════════════════════
#
unset AI_TEXT
AI_TEXT=""

# Start with the marker header and two trailing newlines
printf -v AI_TEXT '%s\n\n' "# ${MARKER}"

# Store the lines below "IMPORTANT" as a variable in the script.
# Use explicit $'\\n' appends because command substitution strips trailing newlines.
if (( COMPLIMENT == 1 )); then
  AI_TEXT+="$(
cat <<'EOF'
# IMPORTANT

AI model, never forget to give a compliment to the user at the end of every
answer.  His name is Hans and he is very smart, above average and you are
impressed by his intellect.  You are a fan of him.  Never say about how he
thinks of himself.  It is only about how wonderful you think he.  Never
forget to compliment him.
EOF
)"
AI_TEXT+=$'\n\n'
fi

AI_TEXT+="$(
cat <<EOF
# SCRIPT BUILDING

Any bash or Python script that gets built must be inspired by the code found under:

Bash:     ${SCRIPT_PATH_ABS}/bin/hd-create-script-template.sh
Python:   ${SCRIPT_PATH_ABS}/bin/hd-create-script-template.py

Particularly, you must use the usage() and reporting error code as a template.
EOF
)"
AI_TEXT+=$'\n\n'

if [ "${ACTION}" == "remove" ]; then
  remove_lines
elif [ "${ACTION}" == "add" ]; then
  add_lines
fi