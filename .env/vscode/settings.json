int\",\n    \"ServiceCatalogProductEC2SrvLicSybaseLaunchConstraint\",\n    \"ServiceCatalogProductEC2SybaseLaunchConstraint\",\n    \"ServiceCatalogProductRDSOracleLaunchConstraint\",\n    \"ServiceCatalogProductRDSSQLServerLaunchConstraint\",\n    \"SynchronisationAccesPortfolioSNS\",\n    \"SynchronisationAccesPortfolioSNSWithSuffix\",\n\\]\nfor r in resources_to_remove:\n    template\\[\"Resources\"\\]\\.pop\\(r, None\\)\n\nwith open\\(\"/tmp/cdpq-sc-bd-no-portfolio\\.yaml\", \"w\"\\) as f:\n    yaml\\.dump\\(template, f, Dumper=CFDumper, default_flow_style=False, allow_unicode=True\\)\n\nprint\\(f\"Done\\. Remaining resources: \\{len\\(template\\['Resources'\\]\\)\\}\"\\)\nEOF\nhead -8 /tmp/cdpq-sc-bd-no-portfolio\\.yaml$/": {
